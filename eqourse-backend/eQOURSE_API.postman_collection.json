{
  "info": {
    "_postman_id": "eqourse-api-collection-v2",
    "name": "eQOURSE Backend API",
    "description": "All REST API endpoints for the eQOURSE EdTech platform backend.\n\nBase URL: {{base_url}}\n\nSet the `base_url` variable to `http://localhost:5001/api` for local development.\n\nFor admin-protected routes, first call POST /auth/login to get a token, then set the `auth_token` collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5001/api",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string",
      "description": "JWT token received after admin login"
    }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('auth_token', res.token);",
                  "  console.log('✅ Token saved to collection variable auth_token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@eqourse.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Admin login. On success, the JWT is automatically saved to `auth_token` collection variable."
          }
        },
        {
          "name": "Get Current Admin (Me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Returns the currently authenticated admin profile."
          }
        }
      ]
    },
    {
      "name": "📬 Contact Us",
      "item": [
        {
          "name": "Submit Contact Query",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@company.com\",\n  \"phone\": \"9876543210\",\n  \"phone_code\": \"+91\",\n  \"company\": \"ABC EdTech Pvt Ltd\",\n  \"designation\": \"Content Manager\",\n  \"subject\": \"K-12 Content Development\",\n  \"message\": \"We are looking for CBSE-aligned content for grades 6-10.\",\n  \"source\": \"Google Search\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/contact",
              "host": ["{{base_url}}"],
              "path": ["contact"]
            },
            "description": "Public endpoint. Saves a contact inquiry to the database."
          }
        },
        {
          "name": "List All Contact Queries (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/contact?page=1&pageSize=20&status=new",
              "host": ["{{base_url}}"],
              "path": ["contact"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "status", "value": "new", "description": "Filter by status: new | in_progress | contacted | closed" }
              ]
            },
            "description": "Admin only. Returns paginated list of contact queries with optional status filter."
          }
        },
        {
          "name": "Get Contact Query Details (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/contact/:id",
              "host": ["{{base_url}}"],
              "path": ["contact", ":id"],
              "variable": [
                { "key": "id", "value": "<contact_query_id>" }
              ]
            },
            "description": "Admin only. Retrieve details for a single contact inquiry by MongoDB ID."
          }
        },
        {
          "name": "Update Contact Query (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"contacted\",\n  \"internalNotes\": \"Called on 2026-05-19. Interested in K-12 content.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/contact/:id",
              "host": ["{{base_url}}"],
              "path": ["contact", ":id"],
              "variable": [
                { "key": "id", "value": "<contact_query_id>" }
              ]
            },
            "description": "Admin only. Update status and internal notes for a contact query."
          }
        },
        {
          "name": "Delete Contact Query (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/contact/:id",
              "host": ["{{base_url}}"],
              "path": ["contact", ":id"],
              "variable": [
                { "key": "id", "value": "<contact_query_id>" }
              ]
            },
            "description": "Admin only. Permanently delete a contact query."
          }
        }
      ]
    },
