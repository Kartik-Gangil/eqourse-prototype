    {
      "name": "📚 Samples",
      "item": [
        {
          "name": "List All Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/samples/categories",
              "host": ["{{base_url}}"],
              "path": ["samples", "categories"]
            },
            "description": "Public. Returns all unique category slugs that have sample documents in the database."
          }
        },
        {
          "name": "List Sample Items (All)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/samples/items",
              "host": ["{{base_url}}"],
              "path": ["samples", "items"]
            },
            "description": "Public. Returns all sample category documents."
          }
        },
        {
          "name": "List Sample Items (Filter by Category)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/samples/items?category=kindergarten-to-k5-samples",
              "host": ["{{base_url}}"],
              "path": ["samples", "items"],
              "query": [
                {
                  "key": "category",
                  "value": "kindergarten-to-k5-samples",
                  "description": "Category slug — must match a frontend page route slug"
                }
              ]
            },
            "description": "Public. Filter sample documents by category slug."
          }
        },
        {
          "name": "Get Single Sample Item by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/samples/items/:id",
              "host": ["{{base_url}}"],
              "path": ["samples", "items", ":id"],
              "variable": [
                { "key": "id", "value": "<sample_item_id>" }
              ]
            },
            "description": "Public. Fetch a single category sample document by its MongoDB _id."
          }
        },
        {
          "name": "Create Sample Item (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"articulate-storyline-video-samples\",\n  \"tabs\": [\n    {\n      \"tab_name\": \"Interactive Modules\",\n      \"order\": 1,\n      \"text\": \"Explore our Articulate Storyline interactive module samples — branching scenarios, quizzes, and immersive activities.\",\n      \"boolean_points\": [\n        \"SCORM-compliant outputs\",\n        \"Works on all LMS platforms\",\n        \"Responsive for mobile & desktop\"\n      ],\n      \"samples\": [\n        {\n          \"name\": \"Safety Training Module – Manufacturing\",\n          \"url\": \"https://example.com/samples/storyline/safety-training.mp4\",\n          \"desc\": \"Interactive branching scenario for factory floor safety training.\",\n          \"format\": \"video\"\n        },\n        {\n          \"name\": \"Compliance Quiz – HR Onboarding\",\n          \"url\": \"https://example.com/samples/storyline/hr-compliance.mp4\",\n          \"desc\": \"Drag-and-drop quiz module for onboarding compliance.\",\n          \"format\": \"video\"\n        }\n      ]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/samples/items",
              "host": ["{{base_url}}"],
              "path": ["samples", "items"]
            },
            "description": "Admin only. Creates a new sample document. One document per category. If the category already exists, use PATCH instead."
          }
        },
        {
          "name": "Update Sample Item (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tabs\": [\n    {\n      \"tab_name\": \"Interactive Modules\",\n      \"order\": 1,\n      \"text\": \"Updated description for interactive modules tab.\",\n      \"boolean_points\": [\n        \"SCORM 1.2 & 2004 compliant\",\n        \"LMS agnostic\",\n        \"Mobile-first design\"\n      ],\n      \"samples\": [\n        {\n          \"name\": \"Updated Safety Training Module\",\n          \"url\": \"https://example.com/samples/updated-safety.mp4\",\n          \"desc\": \"Updated interactive branching scenario.\",\n          \"format\": \"video\"\n        }\n      ]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/samples/items/:id",
              "host": ["{{base_url}}"],
              "path": ["samples", "items", ":id"],
              "variable": [
                { "key": "id", "value": "<sample_item_id>" }
              ]
            },
            "description": "Admin only. Update an existing sample document by ID."
          }
        },
        {
          "name": "Delete Sample Item (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/samples/items/:id",
              "host": ["{{base_url}}"],
              "path": ["samples", "items", ":id"],
              "variable": [
                { "key": "id", "value": "<sample_item_id>" }
              ]
            },
            "description": "Admin only. Permanently deletes a sample document."
          }
        }
      ]
    },
