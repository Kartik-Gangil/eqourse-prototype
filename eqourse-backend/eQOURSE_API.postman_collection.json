            ],
            "url": {
              "raw": "{{base_url}}/pilot/:id",
              "host": ["{{base_url}}"],
              "path": ["pilot", ":id"],
              "variable": [
                { "key": "id", "value": "<pilot_query_id>" }
              ]
            },
            "description": "Admin only. Permanently delete a pilot query."
          }
        }
      ]
    },
    {
      "name": "✍️ Blogs",
      "item": [
        {
          "name": "List Published Blogs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/blogs?page=1&limit=10&tags=AI&is_featured=true",
              "host": ["{{base_url}}"],
              "path": ["blogs"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "tags", "value": "AI" },
                { "key": "is_featured", "value": "true" }
              ]
            },
            "description": "Public. List all published blogs with optional filter queries."
          }
        },
        {
          "name": "Get Published Blog By Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/blogs/:slug",
              "host": ["{{base_url}}"],
              "path": ["blogs", ":slug"],
              "variable": [
                { "key": "slug", "value": "unlocking-ai-in-edtech" }
              ]
            },
            "description": "Public. Retrieve a single blog post details by slug (increments view count)."
          }
        },
        {
          "name": "Admin List All Blogs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/blogs/admin/all?page=1&limit=50&status=draft",
              "host": ["{{base_url}}"],
              "path": ["blogs", "admin", "all"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "50" },
                { "key": "status", "value": "draft" }
              ]
            },
            "description": "Admin only. Returns all blog posts including drafts."
          }
        },
        {
          "name": "Admin Create Blog Post",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Unlocking AI in EdTech\",\n  \"slug\": \"unlocking-ai-in-edtech\",\n  \"excerpt\": \"How artificial intelligence is changing customized curriculum solutions.\",\n  \"body\": \"<p>Full HTML or Markdown text goes here...</p>\",\n  \"bodyFormat\": \"html\",\n  \"coverImageUrl\": \"https://images.unsplash.com/photo-1516321318423-f06f85e504b3\",\n  \"author\": {\n    \"name\": \"John Doe\",\n    \"avatarUrl\": \"\"\n  },\n  \"tags\": [\"AI\", \"EdTech\"],\n  \"grade\": \"10\",\n  \"board_course\": \"CBSE\",\n  \"subject\": \"Computer Science\",\n  \"seo\": {\n    \"title\": \"AI EdTech Solution | eQOURSE\",\n    \"description\": \"Comprehensive post about custom AI modules.\"\n  },\n  \"status\": \"draft\",\n  \"is_featured\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/blogs/admin",
              "host": ["{{base_url}}"],
              "path": ["blogs", "admin"]
            },
            "description": "Admin only. Creates a new blog post in draft or published status."
          }
